{
  "manifest_version": 3,
  "name": "AlgoReflect",
  "version": "0.1.0",
  "description": "Reflect on your LeetCode solution complexity before AI feedback.",
  "action": {
    "default_title": "AlgoReflect"
  },
  "host_permissions": [
    "https://leetcode.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["content.js"]
    }
  ]
}
